        {
            "pattern": "^:(\\d+)",
            "code": "// \":8080\" öffnet http://localhost:8080\nwindow.location = `http://localhost:${match[1]}`;"
        },
        {
            "pattern": "^=(.+)",
            "code": "// \"=6*7\" rechnet und schreibt das Ergebnis zurück in die Eingabe\nlet cmdInput = document.getElementById('cmd-input');\ntry {\n    let result = eval(match[1]);\n    setTimeout(() => {\n        cmdInput.value = result;\n    }, 10);\n} catch (e) {\n    alert('Invalid expression');\n}"
        },
        {
            "pattern": "^yt:(.+)",
            "code": "// \"yt:lofi\" sucht auf YouTube\nwindow.location = 'https://www.youtube.com/results?search_query=' + encodeURIComponent(match[1]);"
        },
        {
            "pattern": "^w:(.+)",
            "code": "// \"w:Aachen\" sucht in der Wikipedia\nwindow.location = 'https://en.wikipedia.org/w/index.php?search=' + encodeURIComponent(match[1]);"
        },
        {
            "pattern": "^gh:(.+)",
            "code": "// \"gh:python/cpython\" öffnet ein GitHub-Repository\nwindow.location = `https://github.com/${match[1]}`;"
        },
        {
            "pattern": "^open:(.+)",
            "code": "// \"open:https://example.org\" öffnet die URL in einem neuen Tab\nwindow.open(match[1], '_blank');"
        }
    ]
